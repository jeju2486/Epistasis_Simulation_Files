// Build a neutral four-lineage bacterial population and seed four balanced,
// predeclared standing variants A-D at the checkpoint. Target: SLiM 5.2.

initialize() {
    initializeSLiMModelType("nonWF");
    initializeSLiMOptions(keepPedigrees=T, nucleotideBased=T);
    // Adults reproduce once and are then removed, so one tick is exactly one
    // generation.  Declare that equivalence for downstream msprime use.
    initializeTreeSeq(timeUnit="generations");

    if (!exists("REF_FILE")) defineConstant("REF_FILE", "inputs/reference_100kb.fa");
    if (!exists("CHECKPOINT_FILE")) defineConstant("CHECKPOINT_FILE", "checkpoint.trees");
    if (!exists("LOCI_FILE")) defineConstant("LOCI_FILE", "selected_loci.tsv");
    if (!exists("METRICS_FILE")) defineConstant("METRICS_FILE", "checkpoint_metrics.tsv");

    if (!exists("GENOME_LENGTH")) defineConstant("GENOME_LENGTH", 100000);
    if (!exists("MU")) defineConstant("MU", 2e-8);
    if (!exists("TRACT_LENGTH")) defineConstant("TRACT_LENGTH", 500);
    if (!exists("HGT_P_WITHIN")) defineConstant("HGT_P_WITHIN", 0.02);

    if (!exists("N_ANCESTRAL")) defineConstant("N_ANCESTRAL", 10000);
    if (!exists("N_CLADE")) defineConstant("N_CLADE", 5000);
    if (!exists("N_TERMINAL")) defineConstant("N_TERMINAL", 2500);
    if (!exists("ANCESTRAL_GENERATIONS")) defineConstant("ANCESTRAL_GENERATIONS", 5000);
    if (!exists("DEEP_GENERATIONS")) defineConstant("DEEP_GENERATIONS", 1000);
    if (!exists("TERMINAL_GENERATIONS")) defineConstant("TERMINAL_GENERATIONS", 1000);

    if (!exists("A_POSITION")) defineConstant("A_POSITION", 10000);
    if (!exists("B_POSITION")) defineConstant("B_POSITION", 20000);
    if (!exists("C_POSITION")) defineConstant("C_POSITION", 60000);
    if (!exists("D_POSITION")) defineConstant("D_POSITION", 85000);

    defineConstant("DEEP_SPLIT_TICK", ANCESTRAL_GENERATIONS);
    defineConstant("TERMINAL_SPLIT_TICK", ANCESTRAL_GENERATIONS + DEEP_GENERATIONS);
    defineConstant("CHECKPOINT_TICK", ANCESTRAL_GENERATIONS + DEEP_GENERATIONS + TERMINAL_GENERATIONS);

    defineConstant("L", initializeAncestralNucleotides(REF_FILE));
    if (L != GENOME_LENGTH)
        stop("Reference length does not equal GENOME_LENGTH.");

    initializeMutationTypeNuc("m1", 1.0, "f", 0.0);
    m1.convertToSubstitution = F;
    initializeMutationTypeNuc("m2", 1.0, "f", 0.0);
    m2.convertToSubstitution = F;
    initializeGenomicElementType("g1", m1, 1.0, mmJukesCantor(MU));
    initializeGenomicElementType("g0", m1, 1.0, mmJukesCantor(0.0));
    initializeGenomicElement(g1, 0, A_POSITION - 1);
    initializeGenomicElement(g0, A_POSITION, A_POSITION);
    initializeGenomicElement(g1, A_POSITION + 1, B_POSITION - 1);
    initializeGenomicElement(g0, B_POSITION, B_POSITION);
    initializeGenomicElement(g1, B_POSITION + 1, C_POSITION - 1);
    initializeGenomicElement(g0, C_POSITION, C_POSITION);
    initializeGenomicElement(g1, C_POSITION + 1, D_POSITION - 1);
    initializeGenomicElement(g0, D_POSITION, D_POSITION);
    initializeGenomicElement(g1, D_POSITION + 1, L - 1);

    // All homologous exchange is implemented explicitly as HGT tracts.
    initializeRecombinationRate(0.0);
}

function (integer$) targetSize(o<Subpopulation>$ pop) {
    if (pop.name == "p0") return N_ANCESTRAL;
    if ((pop.name == "p5") | (pop.name == "p6")) return N_CLADE;
    return N_TERMINAL;
}

function (object<Mutation>) seedStandingLoci(void) {
    positions = c(A_POSITION, B_POSITION, C_POSITION, D_POSITION);
    if ((size(unique(positions)) != 4) | any(positions != sort(positions)))
        stop("A-D positions must be unique and ordered A < B < C < D.");
    if ((positions[0] < 0) | (positions[3] >= L))
        stop("A-D positions must lie within the genome.");
    if ((B_POSITION - A_POSITION) == (D_POSITION - C_POSITION))
        stop("A-B and C-D distances must differ in this design.");
    existingPositions = sim.mutations.position;
    if (any(existingPositions == A_POSITION) | any(existingPositions == B_POSITION) |
        any(existingPositions == C_POSITION) | any(existingPositions == D_POSITION))
        stop("A background mutation occurred at a protected focal position.");

    // Randomize individuals within each terminal population, then cycle through
    // all 16 four-locus haplotypes. With N=2500, every haplotype occurs 156 or
    // 157 times per population; focal prevalences are therefore 0.4992-0.5000.
    for (pop in sim.subpopulations) {
        shuffled = sample(pop.individuals, pop.individualCount);
        shuffled.tag = integerMod(seqAlong(shuffled), 16);
    }

    allIndividuals = sim.subpopulations.individuals;
    divisors = c(1, 2, 4, 8);
    for (i in 0:3) {
        states = integerMod(asInteger(allIndividuals.tag / divisors[i]), 2);
        carriers = allIndividuals[states == 1];
        targets = carriers.haplosomesNonNull;
        ancestral = sim.chromosome.ancestralNucleotides(positions[i], positions[i]);
        derived = "A";
        if (ancestral == "A")
            derived = "C";
        focal = targets[0].addNewMutation(m2, 0.0, positions[i],
            originSubpop=NULL, nucleotide=derived);
        if (size(targets) > 1)
            targets[1:(size(targets) - 1)].addMutations(focal);
    }
    allIndividuals.tag = 0;

    loci = sim.mutationsOfType(m2);
    if (size(loci) != 4)
        stop("Expected exactly four seeded focal mutations.");
    return loci[order(loci.position)];
}

function (void) writeCheckpointMetrics(object<Mutation> loci) {
    labels = c("A", "B", "C", "D");
    fg = sim.mutationFrequencies(NULL, loci);
    f1 = sim.mutationFrequencies(p1, loci);
    f2 = sim.mutationFrequencies(p2, loci);
    f3 = sim.mutationFrequencies(p3, loci);
    f4 = sim.mutationFrequencies(p4, loci);

    header = "label\tmutation_id\tposition\tderived_nucleotide\tseeding_design\tglobal_frequency\tp1_frequency\tp2_frequency\tp3_frequency\tp4_frequency\n";
    writeFile(LOCI_FILE, header, append=F);

    for (i in 0:3) {
        line = labels[i] + "\t" + loci[i].id + "\t" + loci[i].position + "\t" +
               loci[i].nucleotide + "\tbalanced_16_haplotype_cycle\t" +
               fg[i] + "\t" + f1[i] + "\t" + f2[i] + "\t" + f3[i] + "\t" + f4[i] + "\n";
        writeFile(LOCI_FILE, line, append=T);
    }

    metrics = "metric\tvalue\n" +
              "tick\t" + community.tick + "\n" +
              "p1_size\t" + p1.individualCount + "\n" +
              "p2_size\t" + p2.individualCount + "\n" +
              "p3_size\t" + p3.individualCount + "\n" +
              "p4_size\t" + p4.individualCount + "\n" +
              "background_mutation_count\t" + size(sim.mutationsOfType(m1)) + "\n" +
              "seeded_mutation_count\t" + size(loci) + "\n" +
              "seeding_design\tbalanced_16_haplotype_cycle\n" +
              "A_position\t" + A_POSITION + "\n" +
              "B_position\t" + B_POSITION + "\n" +
              "C_position\t" + C_POSITION + "\n" +
              "D_position\t" + D_POSITION + "\n";

    for (i in 0:2) {
        for (j in (i + 1):3) {
            distance = abs(loci[i].position - loci[j].position);
            r2 = calcLD_Rsquared(loci[i], loci[j], haplosomes=sim.subpopulations.haplosomesNonNull);
            metrics = metrics + "distance_" + labels[i] + labels[j] + "\t" + distance + "\n" +
                      "r2_" + labels[i] + labels[j] + "\t" + r2 + "\n";
        }
    }

    writeFile(METRICS_FILE, metrics, append=F);
}

// Two offspring per adult provide room for viability regulation. Adults are
// removed in early(), producing non-overlapping haploid generations.
reproduction() {
    for (rep in 0:1) {
        if ((runif(1) < HGT_P_WITHIN) & (subpop.individualCount > 1)) {
            donor = subpop.sampleIndividuals(1, exclude=individual).haplosomes[0];
            start = rdunif(1, 0, L - 1);
            tract = asInteger(max(1, rgeom(1, 1.0 / TRACT_LENGTH)));
            end = min(L - 1, start + tract - 1);
            subpop.addRecombinant(individual.haplosomes[0], donor, c(start, end),
                NULL, NULL, NULL, randomizeStrands=F);
        }
        else
            subpop.addCloned(individual);
    }
}

1 early() {
    if ((HGT_P_WITHIN < 0.0) | (HGT_P_WITHIN > 1.0))
        stop("HGT_P_WITHIN must be between zero and one.");
    sim.addSubpop("p0", N_ANCESTRAL, haploid=T);
}

early() {
    if (community.tick == 1)
        return;

    for (pop in sim.subpopulations) {
        adults = pop.individuals[pop.individuals.age > 0];
        if (size(adults) > 0)
            adults.fitnessScaling = 0.0;

        juveniles = pop.individuals[pop.individuals.age == 0];
        if (size(juveniles) == 0)
            next;

        scale = targetSize(pop) / size(juveniles);
        juveniles.fitnessScaling = min(1.0, scale);
    }
}

DEEP_SPLIT_TICK late() {
    // SLiM requires subpopulation names to be p followed by an integer.
    // p5 and p6 are the temporary left/right ancestral clades.
    sim.addSubpop("p5", 0, haploid=T);
    sim.addSubpop("p6", 0, haploid=T);

    shuffled = sample(p0.individuals, p0.individualCount);
    leftCount = asInteger(floor(size(shuffled) / 2));
    p5.takeMigrants(shuffled[0:(leftCount - 1)]);
    p6.takeMigrants(shuffled[leftCount:(size(shuffled) - 1)]);
    p0.removeSubpopulation();
}

TERMINAL_SPLIT_TICK late() {
    sim.addSubpop("p1", 0, haploid=T);
    sim.addSubpop("p2", 0, haploid=T);
    sim.addSubpop("p3", 0, haploid=T);
    sim.addSubpop("p4", 0, haploid=T);

    left = sample(p5.individuals, p5.individualCount);
    right = sample(p6.individuals, p6.individualCount);
    leftCount = asInteger(floor(size(left) / 2));
    rightCount = asInteger(floor(size(right) / 2));

    p1.takeMigrants(left[0:(leftCount - 1)]);
    p2.takeMigrants(left[leftCount:(size(left) - 1)]);
    p3.takeMigrants(right[0:(rightCount - 1)]);
    p4.takeMigrants(right[rightCount:(size(right) - 1)]);

    p5.removeSubpopulation();
    p6.removeSubpopulation();
}

CHECKPOINT_TICK late() {
    loci = seedStandingLoci();
    writeCheckpointMetrics(loci);
    sim.treeSeqOutput(CHECKPOINT_FILE);
    sim.simulationFinished();
}

// Continue a four-lineage checkpoint to absolute tick END_TICK under one of
// two frequency-dependent A-B equilibrium regimes. Target: SLiM 5.2.

initialize() {
    initializeSLiMModelType("nonWF");
    initializeSLiMOptions(keepPedigrees=T, nucleotideBased=T);
    initializeTreeSeq(timeUnit="generations");

    if (!exists("REF_FILE")) defineConstant("REF_FILE", "inputs/reference_100kb.fa");
    if (!exists("CHECKPOINT_FILE")) defineConstant("CHECKPOINT_FILE", "checkpoint.trees");
    if (!exists("TREE_OUT")) defineConstant("TREE_OUT", "out.trees");
    if (!exists("VCF_OUT")) defineConstant("VCF_OUT", "out.vcf");
    if (!exists("SAMPLE_FILE")) defineConstant("SAMPLE_FILE", "sample_names.tsv");
    if (!exists("LOCI_FILE")) defineConstant("LOCI_FILE", "selected_loci.tsv");
    if (!exists("ENDPOINT_FILE")) defineConstant("ENDPOINT_FILE", "focal_endpoint.tsv");
    if (!exists("GENOME_LENGTH")) defineConstant("GENOME_LENGTH", 100000);
    if (!exists("MU")) defineConstant("MU", 2e-8);
    if (!exists("TRACT_LENGTH")) defineConstant("TRACT_LENGTH", 500);
    if (!exists("HGT_P_WITHIN")) defineConstant("HGT_P_WITHIN", 0.02);
    if (!exists("N_TERMINAL")) defineConstant("N_TERMINAL", 2500);
    if (!exists("SAMPLE_PER_TERMINAL")) defineConstant("SAMPLE_PER_TERMINAL", 250);
    if (!exists("END_TICK")) defineConstant("END_TICK", 30000);
    if (!exists("MODE")) defineConstant("MODE", 1);
    if (!exists("FDS_STRENGTH")) defineConstant("FDS_STRENGTH", 0.25);
    if (!exists("FDS_EPSILON")) defineConstant("FDS_EPSILON", 0.0002);
    if (!exists("A_POSITION")) defineConstant("A_POSITION", 10000);
    if (!exists("B_POSITION")) defineConstant("B_POSITION", 50000);

    defineConstant("L", initializeAncestralNucleotides(REF_FILE));
    if (L != GENOME_LENGTH)
        stop("Reference length does not equal GENOME_LENGTH.");
    initializeMutationTypeNuc("m1", 1.0, "f", 0.0);
    m1.convertToSubstitution = F;
    initializeMutationTypeNuc("m2", 1.0, "f", 0.0);
    m2.convertToSubstitution = F;
    initializeGenomicElementType("g1", m1, 1.0, mmJukesCantor(MU));
    initializeGenomicElementType("g0", m1, 1.0, mmJukesCantor(0.0));
    initializeGenomicElement(g1, 0, A_POSITION - 1);
    initializeGenomicElement(g0, A_POSITION, A_POSITION);
    initializeGenomicElement(g1, A_POSITION + 1, B_POSITION - 1);
    initializeGenomicElement(g0, B_POSITION, B_POSITION);
    initializeGenomicElement(g1, B_POSITION + 1, L - 1);
    initializeRecombinationRate(0.0);
}

function (logical$) hasMutation(o<Individual>$ ind, integer$ mutationID) {
    return any(ind.haplosomes[0].mutations.id == mutationID);
}

function (integer$) abState(o<Individual>$ ind) {
    state = 0;
    if (hasMutation(ind, asInteger(sim.getValue("A_ID")))) state = state + 2;
    if (hasMutation(ind, asInteger(sim.getValue("B_ID")))) state = state + 1;
    return state;
}

function (float) targetFrequencies(o<Subpopulation>$ pop) {
    highClade = (pop.name == "p1") | (pop.name == "p2");
    if (MODE == 1) {
        if (highClade) return c(0.0225, 0.1275, 0.1275, 0.7225);
        return c(0.7225, 0.1275, 0.1275, 0.0225);
    }
    if (highClade) return c(0.25, 0.05, 0.45, 0.25);
    return c(0.25, 0.45, 0.05, 0.25);
}

function (integer) pairCounts(o<Individual> individuals) {
    counts = integer(4);
    for (ind in individuals) {
        state = abState(ind);
        counts[state] = counts[state] + 1;
    }
    return counts;
}

function (object<Mutation>) seedFocalLoci(void) {
    if (!((0 <= A_POSITION) & (A_POSITION < B_POSITION) & (B_POSITION < L)))
        stop("Require 0 <= A_POSITION < B_POSITION < genome length.");
    if (any(sim.mutations.position == A_POSITION) | any(sim.mutations.position == B_POSITION))
        stop("The checkpoint contains a mutation at A or B.");

    for (pop in sim.subpopulations) {
        shuffled = sample(pop.individuals, pop.individualCount);
        haplotypeOrder = c(0, 3, 1, 2);
        shuffled.tag = haplotypeOrder[integerMod(seqAlong(shuffled), 4)];
    }
    allIndividuals = sim.subpopulations.individuals;
    positions = c(A_POSITION, B_POSITION);
    for (i in 0:1) {
        if (i == 0)
            carriers = allIndividuals[allIndividuals.tag >= 2];
        else
            carriers = allIndividuals[integerMod(allIndividuals.tag, 2) == 1];
        targets = carriers.haplosomesNonNull;
        ancestral = sim.chromosome.ancestralNucleotides(positions[i], positions[i]);
        derived = "A";
        if (ancestral == "A") derived = "C";
        focal = targets[0].addNewMutation(m2, 0.0, positions[i],
            originSubpop=NULL, nucleotide=derived);
        if (size(targets) > 1)
            targets[1:(size(targets) - 1)].addMutations(focal);
    }
    allIndividuals.tag = 0;
    loci = sim.mutationsOfType(m2);
    if (size(loci) != 2)
        stop("Expected exactly two seeded focal mutations.");
    return loci[order(loci.position)];
}

function (void) writeSelectedLoci(object<Mutation> loci) {
    header = "label\tmutation_id\tposition\tderived_nucleotide\tseeded_frequency\tmode\n";
    writeFile(LOCI_FILE, header, append=F);
    labels = c("A", "B");
    for (i in 0:1) {
        locus = loci[i];
        line = labels[i] + "\t" + locus.id + "\t" + locus.position + "\t" +
               locus.nucleotide + "\t" + sim.mutationFrequencies(NULL, locus) + "\t" + MODE + "\n";
        writeFile(LOCI_FILE, line, append=T);
    }
}

function (void) writeEndpoint(void) {
    header = "tick\tmode\tpopulation\tn\ttarget_00\ttarget_01\ttarget_10\ttarget_11\tcount_00\tcount_01\tcount_10\tcount_11\tfreq_00\tfreq_01\tfreq_10\tfreq_11\n";
    writeFile(ENDPOINT_FILE, header, append=F);
    for (pop in sim.subpopulations) {
        counts = pairCounts(pop.individuals);
        freqs = counts / pop.individualCount;
        target = targetFrequencies(pop);
        line = community.tick + "\t" + MODE + "\t" + pop.name + "\t" + pop.individualCount;
        for (value in target) line = line + "\t" + value;
        for (value in counts) line = line + "\t" + value;
        for (value in freqs) line = line + "\t" + value;
        writeFile(ENDPOINT_FILE, line + "\n", append=T);
    }
}

function (void) finishRun(void) {
    writeEndpoint();
    sampled = NULL;
    for (pop in sim.subpopulations) {
        draw = pop.sampleIndividuals(min(SAMPLE_PER_TERMINAL, pop.individualCount));
        if (isNULL(sampled)) sampled = draw;
        else sampled = c(sampled, draw);
    }
    writeFile(SAMPLE_FILE, "vcf_label\tanalysis_label\tpopulation\tpedigree_id\tindividual_index\n", append=F);
    for (ind in sampled) {
        vcfLabel = "p" + ind.subpopulation.id + ":i" + ind.index;
        analysisLabel = "p" + ind.subpopulation.id + "_i" + ind.index;
        line = vcfLabel + "\t" + analysisLabel + "\t" + ind.subpopulation.name + "\t" + ind.pedigreeID + "\t" + ind.index + "\n";
        writeFile(SAMPLE_FILE, line, append=T);
    }
    sim.treeSeqRememberIndividuals(sampled);
    sim.treeSeqOutput(TREE_OUT);
    sampled.outputIndividualsToVCF(filePath=VCF_OUT, simplifyNucleotides=T);
    sim.simulationFinished();
}

reproduction() {
    for (rep in 0:1) {
        donor = NULL;
        if ((runif(1) < HGT_P_WITHIN) & (subpop.individualCount > 1))
            donor = subpop.sampleIndividuals(1, exclude=individual).haplosomes[0];
        if (isNULL(donor))
            subpop.addCloned(individual);
        else {
            start = rdunif(1, 0, L - 1);
            tract = asInteger(max(1, rgeom(1, 1.0 / TRACT_LENGTH)));
            end = min(L - 1, start + tract - 1);
            subpop.addRecombinant(individual.haplosomes[0], donor, c(start, end),
                NULL, NULL, NULL, randomizeStrands=F);
        }
    }
}

s1 1 early() {
    if (!((MODE == 1) | (MODE == 2))) stop("MODE must be 1 or 2.");
    if ((FDS_STRENGTH <= 0.0) | (FDS_EPSILON <= 0.0))
        stop("Frequency-dependence parameters must be positive.");
    sim.readFromPopulationFile(CHECKPOINT_FILE);
    if (size(sim.subpopulations) != 4)
        stop("Checkpoint must contain p1-p4.");
    if (END_TICK <= community.tick)
        stop("END_TICK must be later than the checkpoint tick.");
    loci = seedFocalLoci();
    sim.setValue("A_ID", loci[loci.position == A_POSITION].id);
    sim.setValue("B_ID", loci[loci.position == B_POSITION].id);
    writeSelectedLoci(loci);
    sim.setValue("loaded", T);
    community.rescheduleScriptBlock(s2, start=community.tick + 1, end=END_TICK);
    community.rescheduleScriptBlock(s3, start=community.tick + 1, end=END_TICK);
}

s2 2 early() {
    if (isNULL(sim.getValue("loaded"))) return;
    for (pop in sim.subpopulations) {
        adults = pop.individuals[pop.individuals.age > 0];
        if (size(adults) > 0) adults.fitnessScaling = 0.0;
        juveniles = pop.individuals[pop.individuals.age == 0];
        if (size(juveniles) == 0) next;

        states = integer(size(juveniles));
        counts = integer(4);
        for (i in seqAlong(juveniles)) {
            state = abState(juveniles[i]);
            states[i] = state;
            counts[state] = counts[state] + 1;
        }
        freqs = counts / size(juveniles);
        target = targetFrequencies(pop);
        stateLogWeights = FDS_STRENGTH * log((target + FDS_EPSILON) / (freqs + FDS_EPSILON));
        stateLogWeights = stateLogWeights - sum(freqs * stateLogWeights);
        weights = float(size(juveniles));
        for (i in seqAlong(juveniles))
            weights[i] = exp(stateLogWeights[states[i]]);
        scale = N_TERMINAL / sum(weights);
        juveniles.fitnessScaling = pmin(1.0, weights * scale);
    }
}

s3 2 late() {
    if (!isNULL(sim.getValue("loaded")) & (community.tick >= END_TICK))
        finishRun();
}
